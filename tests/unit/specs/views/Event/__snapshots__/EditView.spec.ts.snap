        </div>
      </div>
    </div>
    <div data-oruga="field" class="o-field"><label id="v-0-12" for="website-url" class="o-field__label">Website / URL</label>
      <div data-oruga="input" class="o-input o-input--expanded"><span data-oruga="icon" class="o-icon o-input__icon-left"><i class="mdi mdi-link mdi-24px"></i></span><input aria-labelledby="v-0-12" id="website-url" type="url" data-oruga-input="url" class="o-input__input o-input__input--iconspace-left o-input__input--placeholder" autocomplete="off" placeholder="URL">
        <!---->
        <!---->
      </div>
      <!---->
    </div>
    <section class="my-4">
      <h2>Event metadata</h2>
      <p>Integrate this event with 3rd-party tools and show metadata for the event.</p>
      <section>
        <div class="mb-4"></div>
        <div data-oruga="field" class="o-field flex-wrap justify-center gap-2"><label id="v-0-14" for="event-metadata-autocomplete" class="o-field__label">Find or add an element</label>
          <div data-oruga="autocomplete" class="o-dropdown o-dropdown--expanded o-dropdown--position-auto o-autocomplete">
            <div class="o-dropdown__trigger" role="combobox" aria-haspopup="listbox" aria-expanded="false" aria-disabled="false" aria-controls="v-0-16" aria-labelledby="v-0-14">
              <div data-oruga="input" class="o-input o-input--expanded">
                <!----><input aria-labelledby="v-0-14" data="[object Object],[object Object],[object Object],[object Object],[object Object],[object Object],[object Object],[object Object]" group-field="category" group-options="items" dir="auto" class="flex-1 min-w-[200px] o-input__input o-input__input--placeholder" aria-autocomplete="list" aria-controls="v-0-16" enterkeyhint="enter" id="event-metadata-autocomplete" type="text" data-oruga-input="text" autocomplete="off" placeholder="e.g. Accessibility, Twitch, PeerTube">
                <!---->
