              </div>
            </div>
            <!--teleport start-->
            <!---->
            <transition-stub name="fade" appear="false" persisted="false" css="true">
              <div id="v-0-16" tabindex="-1" class="o-dropdown__menu o-dropdown__menu--auto" style="max-height: 200px; overflow: auto; display: none;" role="listbox" aria-labelledby="v-0-14" aria-multiselectable="false">
                <!---->
                <!---->
                <div id="v-0-16-1" data-oruga="dropdown-item" data-id="dropdown-1" class="o-dropdown__item o-dropdown__item--clickable o-autocomplete__item o-autocomplete__item--empty" role="option" tabindex="-1" aria-selected="false" aria-disabled="false">No results for </div>
                <!---->
              </div>
            </transition-stub>
            <!--teleport end-->
          </div>
          <p class="control"><button data-oruga="button" type="button" role="button" tabindex="0" class="o-button"><span class="o-button__wrapper"><!----><span class="o-button__label">Add new…</span>
              <!----></span>
            </button></p>
          <!---->
        </div>
        <!--teleport start-->
        <transition-stub name="zoom-out" appear="false" persisted="false" css="true">
          <div has-modal-card="" close-button-aria-label="Close" data-oruga="modal" class="o-modal" tabindex="-1" role="dialog" aria-modal="false" style="display: none;">
            <div class="o-modal__overlay" tabindex="-1"></div>
            <div class="o-modal__content" style="max-width: 960px;">
              <div class="">
                <header class="">
                  <h2>Create a new metadata element</h2>
                  <p>You can put any arbitrary content in this element. URLs will be clickable.</p>
                </header>
                <div class="">
                  <form>
                    <div data-oruga="field" class="o-field"><label id="v-0-18" class="o-field__label" for="v-0-20">Element title</label>
                      <div data-oruga="input" class="o-input">
                        <!----><input aria-labelledby="v-0-18" id="v-0-20" type="text" data-oruga-input="text" class="o-input__input o-input__input--placeholder" autocomplete="off">
                        <!---->
                        <!---->
                      </div>
                      <!---->
                    </div>
                    <div data-oruga="field" class="o-field"><label id="v-0-21" class="o-field__label" for="v-0-23">Element value</label>
                      <div data-oruga="input" class="o-input">
                        <!----><input aria-labelledby="v-0-21" id="v-0-23" type="text" data-oruga-input="text" class="o-input__input o-input__input--placeholder" autocomplete="off">
                        <!---->
                        <!---->
                      </div>
                      <!---->
                    </div><button data-oruga="button" type="submit" role="button" tabindex="0" class="o-button o-button--primary mt-2"><span class="o-button__wrapper"><!----><span class="o-button__label">Add</span>
                      <!----></span>
                    </button>
                  </form>
                </div>
              </div><button type="button" class="o-modal__close" aria-label="Close" data-oruga="close" style="display: none;"><span data-oruga="icon" class="o-icon o-icon--medium"><i class="mdi mdi-close mdi-36px"></i></span></button>
            </div>
          </div>
        </transition-stub>
        <!--teleport end-->
      </section>
    </section>
    <section class="my-4">
      <h2>Who can view this event and participate</h2>
      <fieldset>
        <legend>When the event is private, you'll need to share the link around.</legend>
        <div class="field">
          <div data-oruga="radio" class="o-radio o-radio--checked"><input id="v-0-24" type="radio" data-oruga-input="radio" class="o-radio__input" name="eventVisibility" autocomplete="off" aria-checked="true" aria-labelledby="v-0-25" value="PUBLIC"><label id="v-0-25" for="v-0-24" class="o-radio__label">Visible everywhere on the web (public)</label></div>
        </div>
        <div class="field">
          <div data-oruga="radio" class="o-radio"><input id="v-0-26" type="radio" data-oruga-input="radio" class="o-radio__input" name="eventVisibility" autocomplete="off" aria-checked="false" aria-labelledby="v-0-27" value="UNLISTED"><label id="v-0-27" for="v-0-26" class="o-radio__label">Only accessible through link (private)</label></div>
        </div>
      </fieldset>
