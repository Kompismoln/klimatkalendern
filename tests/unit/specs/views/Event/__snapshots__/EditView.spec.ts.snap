    <section class="my-4">
      <h2>Status</h2>
      <fieldset id="status">
        <legend>Does the event needs to be confirmed later or is it cancelled?</legend>
        <div data-oruga="field" class="o-field radio-buttons">
          <!---->
          <div data-oruga="radio" class="o-radio o-radio--warning"><input aria-labelledby="v-0-47" id="v-0-49" type="radio" data-oruga-input="radio" class="o-radio__input" name="status" autocomplete="off" aria-checked="false" value="TENTATIVE"><label id="v-0-47" for="v-0-49" class="o-radio__label">
              <div class="mr-2 p-2 rounded border flex gap-x-1 btn-outlined-warning"><span data-oruga="icon" class="o-icon"><i class="mdi mdi-calendar-question mdi-24px"></i></span> Tentative: Will be confirmed later</div>
            </label></div>
          <div data-oruga="radio" class="o-radio o-radio--success o-radio--checked"><input aria-labelledby="v-0-47" id="v-0-50" type="radio" data-oruga-input="radio" class="o-radio__input" name="status" autocomplete="off" aria-checked="true" value="CONFIRMED"><label id="v-0-47" for="v-0-50" class="o-radio__label">
              <div class="mr-2 p-2 rounded border flex gap-x-1 btn-success"><span data-oruga="icon" class="o-icon"><i class="mdi mdi-calendar-check mdi-24px"></i></span> Confirmed: Will happen</div>
            </label></div>
          <div data-oruga="radio" class="o-radio o-radio--danger"><input aria-labelledby="v-0-47" id="v-0-51" type="radio" data-oruga-input="radio" class="o-radio__input" name="status" autocomplete="off" aria-checked="false" value="CANCELLED"><label id="v-0-47" for="v-0-51" class="o-radio__label">
