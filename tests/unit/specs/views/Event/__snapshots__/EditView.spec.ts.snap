                   name="eventVisibility"
                   :native-value="EventVisibility.PRIVATE">
             {{ t('Page limited to my group (asks for auth)') }}
          </o-radio>
        </div>-->
    </section>
    <section class="my-4">
      <h2>How to register</h2>
      <div class="field">
        <div data-oruga="radio" class="o-radio o-radio--checked"><input id="v-0-28" type="radio" data-oruga-input="radio" class="o-radio__input" name="registerOption" autocomplete="off" aria-checked="true" aria-labelledby="v-0-29" value="mobilizon"><label id="v-0-29" for="v-0-28" class="o-radio__label">I want to manage the registration on Mobilizon</label></div>
      </div>
      <div class="field">
        <div data-oruga="radio" class="o-radio"><input id="v-0-30" type="radio" data-oruga-input="radio" class="o-radio__input" name="registerOption" autocomplete="off" aria-checked="false" aria-labelledby="v-0-31" value="external"><label id="v-0-31" for="v-0-30" class="o-radio__label">I want to manage the registration with an external provider</label></div>
      </div>
      <!--v-if-->
      <div data-oruga="field" class="o-field"><label id="v-0-58" class="o-field__label" for="v-0-60">Anonymous participations</label>
        <div data-oruga="switch" class="o-switch o-switch--position o-switch--rounded"><input aria-labelledby="v-0-58" id="v-0-60" type="checkbox" role="switch" data-oruga-input="switch" class="o-switch__input" true-value="true" false-value="false" autocomplete="off" aria-checked="false"><label id="v-0-58" for="v-0-60" class="o-switch__label">I want to allow people to participate without an account. <small><br> Anonymous participants will be asked to confirm their participation through e-mail.</small></label></div>
        <!---->
      </div>
      <div data-oruga="field" class="o-field"><label id="v-0-32" class="o-field__label" for="v-0-34">Participation approval</label>
        <div data-oruga="switch" class="o-switch o-switch--position o-switch--rounded"><input aria-labelledby="v-0-32" id="v-0-34" type="checkbox" role="switch" data-oruga-input="switch" class="o-switch__input" true-value="true" false-value="false" autocomplete="off" aria-checked="false"><label id="v-0-32" for="v-0-34" class="o-switch__label">I want to approve every participation request</label></div>
        <!---->
      </div>
      <div data-oruga="field" class="o-field"><label id="v-0-35" class="o-field__label" for="v-0-37">Showing participants</label>
        <div data-oruga="switch" class="o-switch o-switch--position o-switch--rounded o-switch--checked"><input aria-labelledby="v-0-35" id="v-0-37" type="checkbox" role="switch" data-oruga-input="switch" class="o-switch__input" true-value="true" false-value="false" autocomplete="off" aria-checked="true"><label id="v-0-35" for="v-0-37" class="o-switch__label">Hide the number of participants</label></div>
        <!---->
      </div>
      <div data-oruga="field" class="o-field"><label id="v-0-38" class="o-field__label" for="v-0-40">Number of places</label>
        <div data-oruga="switch" class="o-switch o-switch--position o-switch--rounded"><input aria-labelledby="v-0-38" id="v-0-40" type="checkbox" role="switch" data-oruga-input="switch" class="o-switch__input" true-value="true" false-value="false" autocomplete="off" aria-checked="false"><label id="v-0-38" for="v-0-40" class="o-switch__label">Limited number of places</label></div>
        <!---->
      </div>
      <!--v-if-->
    </section>
    <section class="my-4">
      <h2>Public comment moderation</h2>
      <fieldset>
        <legend>Who can post a comment?</legend>
        <div data-oruga="field" class="o-field">
          <!---->
          <div data-oruga="radio" class="o-radio o-radio--checked"><input aria-labelledby="v-0-41" id="v-0-43" type="radio" data-oruga-input="radio" class="o-radio__input" name="commentModeration" autocomplete="off" aria-checked="true" value="ALLOW_ALL"><label id="v-0-41" for="v-0-43" class="o-radio__label">Allow all comments from users with accounts</label></div>
          <!---->
        </div><!--          <div class="field">-->
        <!--            <o-radio v-model="eventOptions.commentModeration"-->
        <!--                     name="commentModeration"-->
        <!--                     :native-value="CommentModeration.MODERATED">-->
        <!--              {{ t('Moderated comments (shown after approval)') }}-->
        <!--            </o-radio>-->
        <!--          </div>-->
        <div data-oruga="field" class="o-field">
          <!---->
          <div data-oruga="radio" class="o-radio"><input aria-labelledby="v-0-44" id="v-0-46" type="radio" data-oruga-input="radio" class="o-radio__input" name="commentModeration" autocomplete="off" aria-checked="false" value="CLOSED"><label id="v-0-44" for="v-0-46" class="o-radio__label">Close comments for all (except for admins)</label></div>
          <!---->
        </div>
      </fieldset>
    </section>
    <section class="my-4">
      <h2>Status</h2>
      <fieldset id="status">
        <legend>Does the event needs to be confirmed later or is it cancelled?</legend>
        <div data-oruga="field" class="o-field radio-buttons">
          <!---->
          <div data-oruga="radio" class="o-radio o-radio--warning"><input aria-labelledby="v-0-47" id="v-0-49" type="radio" data-oruga-input="radio" class="o-radio__input" name="status" autocomplete="off" aria-checked="false" value="TENTATIVE"><label id="v-0-47" for="v-0-49" class="o-radio__label">
              <div class="mr-2 p-2 rounded border flex gap-x-1 btn-outlined-warning"><span data-oruga="icon" class="o-icon"><i class="mdi mdi-calendar-question mdi-24px"></i></span> Tentative: Will be confirmed later</div>
            </label></div>
          <div data-oruga="radio" class="o-radio o-radio--success o-radio--checked"><input aria-labelledby="v-0-47" id="v-0-50" type="radio" data-oruga-input="radio" class="o-radio__input" name="status" autocomplete="off" aria-checked="true" value="CONFIRMED"><label id="v-0-47" for="v-0-50" class="o-radio__label">
              <div class="mr-2 p-2 rounded border flex gap-x-1 btn-success"><span data-oruga="icon" class="o-icon"><i class="mdi mdi-calendar-check mdi-24px"></i></span> Confirmed: Will happen</div>
            </label></div>
          <div data-oruga="radio" class="o-radio o-radio--danger"><input aria-labelledby="v-0-47" id="v-0-51" type="radio" data-oruga-input="radio" class="o-radio__input" name="status" autocomplete="off" aria-checked="false" value="CANCELLED"><label id="v-0-47" for="v-0-51" class="o-radio__label">
              <div class="p-2 rounded border flex gap-x-1 btn-outlined-danger dark:text-red-400 dark:border-red-400"><span data-oruga="icon" class="o-icon"><i class="mdi mdi-calendar-remove mdi-24px"></i></span> Cancelled: Won't happen</div>
            </label></div>
          <!---->
        </div>
      </fieldset>
    </section>
  </form>
</div>
<!--teleport start-->
<transition-stub name="zoom-out" appear="false" persisted="false" css="true">
  <div has-modal-card="" close-button-aria-label="Close" data-oruga="modal" class="o-modal" tabindex="-1" role="dialog" aria-modal="false" style="display: none;">
    <div class="o-modal__overlay" tabindex="-1"></div>
    <div class="o-modal__content" style="max-width: 960px;">
      <form class="p-3">
        <header class="">
          <h2 class="">Timezone</h2>
        </header>
        <section class="">
          <p>Event timezone will default to the timezone of the event's address if there is one, or to your own timezone setting.</p>
          <div data-oruga="field" class="o-field" expanded="">
            <!---->
            <div data-oruga="select" class="o-select">
              <!----><select aria-labelledby="v-0-52" loading="false" id="" data-oruga-input="select" class="o-select__input o-select__input--placeholder o-select__input--arrowed" autocomplete="off">
                <option disabled="" hidden="" value="">Select a timezone</option>
              </select>
              <!---->
            </div><button data-oruga="button" type="button" role="button" tabindex="0" class="o-button o-button--disabled reset-area" disabled="" title="Clear timezone field"><span class="o-button__wrapper"><span data-oruga="icon" class="o-icon o-button__icon o-button__icon-left"><i class="mdi mdi-close mdi-24px"></i></span>
              <!---->
              <!----></span>
            </button>
            <!---->
          </div>
        </section>
        <footer class="mt-2"><button data-oruga="button" type="button" role="button" tabindex="0" class="o-button"><span class="o-button__wrapper"><!----><span class="o-button__label">OK</span>
            <!----></span>
          </button></footer>
      </form><button type="button" class="o-modal__close" aria-label="Close" data-oruga="close" style="display: none;"><span data-oruga="icon" class="o-icon o-icon--medium"><i class="mdi mdi-close mdi-36px"></i></span></button>
    </div>
  </div>
</transition-stub>
<!--teleport end-->
<span></span>
<nav role="navigation" aria-label="main navigation" class="bg-mbz-yellow-alt-200 p-3 mt-3 rounded is-fixed-bottom">
  <div class="container mx-auto">
    <div class="lg:flex lg:justify-between lg:items-center lg:flex-wrap">
      <div class="text-red-900 text-center w-full margin m-1 lg:m-0 lg:w-auto lg:text-left">Unsaved changes</div>
      <div class="flex flex-wrap gap-3 items-center justify-end"><button data-oruga="button" type="button" role="button" tabindex="0" class="o-button o-button--text o-button--expanded dark:!text-black ml-auto"><span class="o-button__wrapper"><!----><span class="o-button__label">Cancel</span>
          <!----></span>
        </button><!-- If an event has been published we can't make it draft anymore -->
        <!--v-if--><button data-oruga="button" type="button" role="button" tabindex="0" class="o-button o-button--primary o-button--expanded"><span class="o-button__wrapper"><!----><span class="o-button__label"><span>Create my event</span></span>
          <!----></span>
        </button>
      </div>
    </div>
  </div>
</nav>"
`;

exports[`EditView > Create event - draft 2`] = `
"<div class="container mx-auto">
  <h1 class="">Create a new event</h1>
  <form>
    <h2>General information</h2>
    <div data-oruga="field" class="o-field"><label id="v-0-61" class="o-field__label">Headline picture</label>
      <div><label data-oruga="upload" class="o-upload !flex">
          <div class="o-upload__draggable" role="button" tabindex="0">
            <div class="w-100 text-center p-4 rounded-xl border-dashed border-2 border-gray-600"><span class="mx-auto flex w-fit"><span aria-hidden="true" class="material-design-icon upload-icon" role="img"><svg fill="currentColor" class="material-design-icon__svg" width="24" height="24" viewBox="0 0 24 24"><path d="M9,16V10H5L12,3L19,10H15V16H9M5,20V18H19V20H5Z"><!--v-if--></path></svg></span><span class="capitalize">Click to upload Headline picture</span></span>
              <!--v-if-->
              <!--v-if-->
            </div>
          </div><input aria-labelledby="v-0-61" type="file" data-oruga-input="file" accept="image/gif,image/png,image/jpeg,image/webp">
        </label></div>
      <!--v-if-->
      <!---->
    </div>
    <div data-oruga="field" class="o-field o-field--filled"><label id="v-0-0" for="" class="o-field__label">Title</label>
